<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_pressed"
                android:endColor="@color/accent_blue_pressed"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent"
                android:endColor="@color/accent_blue"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
